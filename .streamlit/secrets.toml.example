# Kopier til .streamlit/secrets.toml lokalt, eller lim inn under «Secrets» i Streamlit Community Cloud.

SUPABASE_URL = "https://<prosjekt-id>.supabase.co"
# Service role-nøkkelen (Supabase: Project Settings → API). Må aldri deles eller legges i git.
SUPABASE_SERVICE_KEY = "<service-role-nøkkel>"

# Valgfritt, men anbefalt: appen krever dette passordet før noe vises.
APP_PASSWORD = "<velg et passord>"
